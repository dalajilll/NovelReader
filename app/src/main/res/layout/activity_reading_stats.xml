<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="阅读统计"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- 统计概览 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- 左侧 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总阅读时长"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/totalTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0小时 0分钟"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 右侧 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今天阅读"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/todayTimeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 章节"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 更详细的统计 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- 已读书籍 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已读书籍"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/booksReadTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 本"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF9800"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 阅读速度 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阅读速度"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/averageSpeedTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200 字/分钟"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#9C27B0"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 名言 修复引号 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="阅读是一种习惯，也是一种态度"
        android:textSize="16sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- 详细统计列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="各书籍阅读情况"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/statsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
