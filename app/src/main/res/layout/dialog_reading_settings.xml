<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 主题选择 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="主题模式"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <RadioGroup
        android:id="@+id/themeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/dayModeRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="日间模式"
            android:checked="true" />

        <RadioButton
            android:id="@+id/nightModeRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="夜间模式"
            android:layout_marginTop="8dp" />

        <RadioButton
            android:id="@+id/eyeModeRadio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="护眼模式"
            android:layout_marginTop="8dp" />

    </RadioGroup>

    <!-- 行距调节 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="行距"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <SeekBar
            android:id="@+id/lineSpacingSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="20"
            android:progress="5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="1.5x"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 自动滚动 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自动滚动"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <Switch
            android:id="@+id/autoScrollSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开启自动滚动" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="速度:"
            android:layout_marginEnd="8dp" />

        <SeekBar
            android:id="@+id/scrollSpeedSeekBar"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="5" />

    </LinearLayout>

    <!-- 字体设置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="字体设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/fontTypeBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="字体类型" />

        <Button
            android:id="@+id/marginBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="页边距" />

    </LinearLayout>

</LinearLayout>